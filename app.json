{
  "expo": {
    "name": "Mediora",
    "slug": "e-heathya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-sante.png",
    "scheme": "patientmedapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.patientmed.app",
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/adaptive-foreground-sante.png",
        "monochromeImage": "./assets/images/adaptive-monochrome-sante.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#059669",
          "defaultChannel": "rappels-medicaments-v3",
          "sounds": ["./assets/sounds/alarme.wav"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mediora utilise votre position pour centrer la carte sur les pharmacies proches de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mediora accède à vos photos pour définir la photo de profil du compte.",
          "cameraPermission": "Mediora utilise l'appareil photo pour prendre la photo de profil du compte.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ad13777-0516-4c8d-8e75-6db176b607ed"
      }
    },
    "owner": "fanantenanarafaniritsoas-organization"
  }
}
